<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仕様§95.4（READ_CALENDAR行）・§66「Permission」。Event Selection機能の初回利用時に
         実行時権限としてリクエストする（起動時の一括要求はしない）。計画書§6.2・§12（裁定B7）
         によりWRITE_CALENDARは追加しない（カレンダー書き込みは仕様§61で明示禁止）。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- 仕様§67・§95.4（ACCESS_FINE_LOCATION行）・S-1裁定（計画書§3.2、2026-08-09）。
         現在地取得によるRoute/ETA計算（F22）。Departure Mode初回利用時に実行時権限として
         リクエストする（起動時の一括要求はしない）。ACCESS_COARSE_LOCATIONはS-1裁定により
         FINEと併記する（Android 12+でFINE単独要求時に「正確な位置／おおよその位置」
         トグルが成立しない既知挙動への対応。ADR記録トリガー⑤）。
         ACCESS_BACKGROUND_LOCATIONは絶対に追加しない（§58「常時監視を前提にしない」・
         §95.1 While-in-use制約・計画書§2.2「やらないこと」）。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 仕様§95.4（INTERNET行）。Routes API（F24/F25、RoutesApiRoutingService経由のHTTP POST）
         呼び出しに必須のnormal permission（実行時要求不要、インストール時に自動付与）。
         P3-C8（quality-runner、実機実測）でT-OPTIN-1がHTTP 403ではなく
         java.lang.SecurityException: Permission denied (missing INTERNET permission?)
         （android_getaddrinfo failed: EPERM、DNS解決時点で失敗）で落ち、本宣言の欠落を
         実測確認した（P3-C1実装漏れ）。P3-C8fixで追加。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 5（F52、仕様§95.4）・ADR-0026。Android 13+（API 33+）の実行時権限。
         POST_NOTIFICATIONSはExecution Plan確定時（PlanReview「Start」）に要求する
         （起動時の一括要求はしない、既存permissionと同じ方針）。拒否時は
         AndroidNotificationService.notifyNowがNotifyResult.Skipped(NOTIFICATIONS_DISABLED)へ
         縮退する（§9エラーマップ#3、握り潰さない）。P5-C6統合ウィンドウで追加。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 5（F50/F51、仕様§95.1）・ADR-0026（S-4）。SCHEDULE_EXACT_ALARMのみ宣言し
         USE_EXACT_ALARM（カレンダー/アラームアプリ限定の特別権限、本アプリは非該当）は
         宣言しない。targetSdk 35のため新規インストール時は既定で不許可
         （実機実測、build/agent-logs/p5-probes-device.md）——inexactフォールバックが
         既定パスになることを製品として受け入れる（ADR-0026 S-4）。P5-C6統合ウィンドウで追加。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Phase 5（F54、仕様§95.6）。端末再起動後のExecutionScheduleStore再登録
         （ScheduleRestoreReceiver）に必須。P5-C6統合ウィンドウで追加。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 5（F56、仕様§95.4）・ADR-0026（S-3）。ExecutionForegroundServiceの起動に必須
         （FOREGROUND_SERVICEはtype別権限の前提として全FGSに共通で必要）。
         P5-C6統合ウィンドウで追加。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Phase 5（F56、仕様§95.1(b)/§95.4）・ADR-0026（S-3）。
         android:foregroundServiceType="location"単独宣言を採用（specialUse/dataSync/
         shortServiceはPlay審査リスク・用途不一致・時間制限によりいずれも却下、ADR-0026）。
         位置権限（ACCESS_FINE_LOCATION/ACCESS_COARSE_LOCATION、上記宣言済み）が
         許可されているときのみFGSを起動し、未許可時はDegraded運用とする
         （ExecutionServiceController.start、T-FGS-6）。ACCESS_BACKGROUND_LOCATIONは
         引き続き追加しない（§58「常時監視を前提にしない」・§95.1 While-in-use制約）。
         P5-C6統合ウィンドウで追加。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".ActionStarterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 5（F56、仕様§95.1(b)/§95.4）・ADR-0026（S-3）。Execution画面がフォアグラウンドの
             間だけ起動される（ExecutionServiceController.start、§7.4の前提保護）。他アプリからは
             起動されないため非公開（exported="false"）。 -->
        <service
            android:name=".services.execution.ExecutionForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Phase 5（F53、仕様§95.1 While-in-use）。AlarmManagerが発火するPendingIntentの宛先
             （計画書§7.3「アラームの宛先はBroadcastReceiver」）。本アプリ自身のAlarmManager
             からのみ起動されるため非公開（exported="false"）。 -->
        <receiver
            android:name=".services.notification.NotificationTriggerReceiver"
            android:exported="false" />

        <!-- Phase 5（F54、仕様§95.6）。BOOT_COMPLETED／TIME_SET（Intent.ACTION_TIME_CHANGEDの
             実体文字列）／TIMEZONE_CHANGED／SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGEDの
             いずれかでExecutionScheduleStoreから再登録する。
             exported値の根拠（計画書に個別指定なしのため既定方針を採用・記録）:
             BOOT_COMPLETEDおよびTIMEZONE_CHANGED等はいずれもprotected system broadcast
             （システム以外が送信元を偽装できない）であり、protected broadcastは
             exported="false"のreceiverにも配送される。したがって他アプリからの偽装Intent
             送信を防げるexported="false"を採用する（信頼境界の防御を最大化する側を選ぶ）。 -->
        <receiver
            android:name=".services.notification.ScheduleRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
